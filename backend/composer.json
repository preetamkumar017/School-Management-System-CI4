{
    "name": "company/school-erp-backend",
    "description": "School ERP backend (School-Management-System-CI4) — first product on the company's CodeIgniter 4 platform",
    "license": "proprietary",
    "type": "project",
    "homepage": "https://codeigniter.com",
    "support": {
        "forum": "https://forum.codeigniter.com/",
        "source": "https://github.com/codeigniter4/CodeIgniter4",
        "slack": "https://codeigniterchat.slack.com"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "dompdf/dompdf": "^3.1",
        "firebase/php-jwt": "^7.1",
        "phpoffice/phpspreadsheet": "^3.5"
    },
    "require-dev": {
        "codeigniter/phpstan-codeigniter": "^2.1",
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5.16",
        "squizlabs/php_codesniffer": "^4.0",
        "zircote/swagger-php": "^6.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "openapi": "php spark openapi:generate",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
